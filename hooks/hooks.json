{
  "description": "Remind the session about in-progress engineering documentation when it starts, resumes, clears, compacts, or forks.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact|fork",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/check-progress.js"]
          }
        ]
      }
    ]
  }
}
